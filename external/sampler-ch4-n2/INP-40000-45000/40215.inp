***,CH4-N2
memory,160,m;
gthresh,energy=1.d-11;
basis=avtz
symmetry,nosym
GEOMETRY={
1, C1,,0.0000000000, 0.0000000000, 0.0000000000
2, H1,,1.4445307907, -1.5372332016, -0.0234132493
3, H2,,-1.3507837413, -0.9222464465, -1.2107038652
4, H3,,-0.6537173246, 0.4564330239, 1.9264727457
5, H4,,0.9370312355, 1.3642308618, -1.1727333078
6, N1,,-1799.7606441693, -155.7480017795, -557.3426866184
7, N2,,-1798.1063430211, -156.8632659425, -557.0560685055
}
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eABa=energy(1)
eABb=energy(2)

dummy, N1,N2
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eAa=energy(1)
eAb=energy(2)

dummy, C1,H1,H2,H3,H4
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eBa=energy(1)
eBb=energy(2)

eCPa=(eABa-eAa-eBa)*tocm
eCPb=(eABb-eAb-eBb)*tocm

{table,eCPa,eCPb;digits,10,10}
