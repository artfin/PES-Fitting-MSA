***,CH4-N2
memory,160,m;
gthresh,energy=1.d-11;
basis=avtz
symmetry,nosym
GEOMETRY={
1, C1,,0.0000000000, 0.0000000000, 0.0000000000
2, H1,,0.8263671511, 1.3421006074, -1.2232973756
3, H2,,-1.4942345497, -1.0535700312, -0.9219825114
4, H3,,1.4171301794, -1.2577278898, 0.8417762361
5, H4,,-0.7852887619, 1.1532840905, 1.5145583551
6, N1,,-86.1386017230, 1578.0635291172, 1036.4913940686
7, N2,,-85.0499528569, 1578.6551379290, 1034.7591903719
}
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eABa=energy(1)
eABb=energy(2)

dummy, N1,N2
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eAa=energy(1)
eAb=energy(2)

dummy, C1,H1,H2,H3,H4
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eBa=energy(1)
eBb=energy(2)

eCPa=(eABa-eAa-eBa)*tocm
eCPb=(eABb-eAb-eBb)*tocm

{table,eCPa,eCPb;digits,10,10}
