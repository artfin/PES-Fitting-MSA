***,CH4-N2
memory,160,m;
gthresh,energy=1.d-11;
basis=avtz
symmetry,nosym
GEOMETRY={
1, C1,,0.0000000000, 0.0000000000, 0.0000000000
2, H1,,1.9881993201, 0.1152287126, 0.3489394365
3, H2,,-0.4756289420, 1.3445160869, -1.4532006569
4, H3,,-0.4041325605, -1.8784553926, -0.7205789297
5, H4,,-0.9538701666, 0.4722662450, 1.7752277316
6, N1,,52.9547119826, 807.8448083699, -1706.7977725330
7, N2,,52.8555310611, 809.8999980438, -1707.2852934499
}
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eABa=energy(1)
eABb=energy(2)

dummy, N1,N2
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eAa=energy(1)
eAb=energy(2)

dummy, C1,H1,H2,H3,H4
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eBa=energy(1)
eBb=energy(2)

eCPa=(eABa-eAa-eBa)*tocm
eCPb=(eABb-eAb-eBb)*tocm

{table,eCPa,eCPb;digits,10,10}
