***,CH4-N2
memory,160,m;
gthresh,energy=1.d-11;
basis=avtz
symmetry,nosym
GEOMETRY={
1, C1,,0.0000000000, 0.0000000000, 0.0000000000
2, H1,,1.5547427122, 1.1273918774, -0.6073370678
3, H2,,-0.6489019608, -1.2184472026, -1.5391604183
4, H3,,0.4819026666, -1.3324494894, 1.4747595929
5, H4,,-1.6653117530, 1.0912363955, 0.5281076410
6, N1,,1072.5890303669, -829.0944674917, 1315.6238854186
7, N2,,1071.9120989919, -830.4287179878, 1317.1227698214
}
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eABa=energy(1)
eABb=energy(2)

dummy, N1,N2
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eAa=energy(1)
eAb=energy(2)

dummy, C1,H1,H2,H3,H4
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eBa=energy(1)
eBb=energy(2)

eCPa=(eABa-eAa-eBa)*tocm
eCPb=(eABb-eAb-eBb)*tocm

{table,eCPa,eCPb;digits,10,10}
