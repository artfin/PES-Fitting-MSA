***,CH4-N2
memory,160,m;
gthresh,energy=1.d-11;
basis=avtz
symmetry,nosym
GEOMETRY={
1, C1,,0.0000000000, 0.0000000000, 0.0000000000
2, H1,,1.6699547323, -1.2082708877, 0.0847548429
3, H2,,-1.3347748853, -1.0398069278, -1.1960398466
4, H3,,-0.5012996679, 0.2770413883, 1.9493137539
5, H4,,1.0433795943, 1.5955165586, -0.8747960672
6, N1,,1423.6998529788, 994.7742394563, 746.3656074448
7, N2,,1423.1950958197, 992.8308253533, 746.5752837132
}
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eABa=energy(1)
eABb=energy(2)

dummy, N1,N2
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eAa=energy(1)
eAb=energy(2)

dummy, C1,H1,H2,H3,H4
{hf,maxit=300}
{ccsd(t)-f12,SINGLES=0,df_basis=avtz/mp2fit,ri_basis=avtz/optri,\
df_basis_exch=avtz/mp2fit,SCALE_TRIP=1,thrvar=1.e-14,gem_beta=1.3,\
maxit=200}
eBa=energy(1)
eBb=energy(2)

eCPa=(eABa-eAa-eBa)*tocm
eCPb=(eABb-eAb-eBb)*tocm

{table,eCPa,eCPb;digits,10,10}
